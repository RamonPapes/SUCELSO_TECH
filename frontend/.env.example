# URL pública da API no Render (sem barra no final)
VITE_API_URL=http://localhost:3001

# Supabase: Project Settings > API. Use SOMENTE a chave pública (anon/publishable).
# NUNCA coloque a service_role key aqui: tudo que começa com VITE_ vai para o navegador.
# Se VITE_SUPABASE_URL ficar vazio, o login usa POST /api/auth/dev-login (somente desenvolvimento local).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
