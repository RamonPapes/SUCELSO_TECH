# Porta HTTP (o Render define PORT automaticamente)
PORT=3001
NODE_ENV=development

# PostgreSQL do Supabase: Project Settings > Database > Connection string > Session pooler (IPv4)
# ex.: postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgres://postgres:postgres@localhost:54329/sucelso
# SSL é ativado automaticamente para hosts que não são localhost (DATABASE_SSL=true|false força)
# DATABASE_SSL=

# Domínio(s) do frontend separados por vírgula (ex.: https://sucelso-tech.vercel.app)
CORS_ORIGIN=http://localhost:5173

# Supabase: Project Settings > API. A service_role key fica SOMENTE aqui no backend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: JWT secret legado (Project Settings > JWT Keys). Se ausente, o token é validado via Supabase Auth.
SUPABASE_JWT_SECRET=

# Somente desenvolvimento local sem Supabase: habilita POST /api/auth/dev-login (ignorado com NODE_ENV=production)
DEV_LOGIN=false
